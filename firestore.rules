rules_version = '2';
// GREEN SIDE 2.15.0 — green-side-2d792
// انسخ هذا الملف كاملاً إلى Firebase ← Firestore Database ← Rules ثم Publish.
service cloud.firestore {
 match /databases/{database}/documents {
  function signedIn(){return request.auth != null;}
  function isOwner(){return signedIn() && exists(/databases/$(database)/documents/config/owner) && get(/databases/$(database)/documents/config/owner).data.uid==request.auth.uid;}
  function hasProfile(){return signedIn() && exists(/databases/$(database)/documents/users/$(request.auth.uid));}
  function myRole(){return get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role;}
  function isSup(){return isOwner() || (hasProfile() && myRole()=='sup');}
  function isWorker(){return hasProfile() && myRole()=='worker';}
  function isMember(){return isSup() || isWorker();}
  function okId(id){return id.matches('[A-Za-z0-9]{20}');}
  function okImg(s,max){return s is string && s.size()<=max && s.matches('data:image/(jpeg|png|gif|webp);base64,[A-Za-z0-9+/=]+');}
  function dayOf(s){let p=s.split('-');return timestamp.date(int(p[0]),int(p[1]),int(p[2]));}
  function farmDay(){return (request.time+duration.value(3,'h')).date();}
  // تسجيل العامل بتاريخ اليوم أو أمس: حتى لا يُرفض تسجيل حُفظ بدون إنترنت ووصل الاتصال بعد منتصف الليل
  function workerDay(s){return dayOf(s)==farmDay() || dayOf(s)==farmDay()-duration.value(1,'d');}
  // Special sensor care records control exclusion windows in reports.
  function ordinaryEntry(d){return d.type!='cal' || !('careKind' in d.v);}
  function validWater(d){return d.type!='waterOnly' || (d.sec=='t' && d.v.waterAdd is number && d.v.waterAdd>0 && d.v.stockSource in ['الخزان الرئيسي لمياه الري','مصدر آخر']);}
  function okEntry(d){
   return d.keys().hasOnly(['type','sec','date','time','ts','by','v','grp','photo','thumb','open','review'])
    && d.type in ['mix','refill','waterOnly','ecph','temp','irr','light','pump','sow','xplant','harvest','note','spray','photo','batt','cal','selftest']
    && d.sec in ['n','t','g'] && gs11Day(d.date) && d.v is map && validWater(d)
    && (!('thumb' in d)||okImg(d.thumb,200000)) && (!('photo' in d)||(d.photo is string && d.photo.size()<=40));
  }
  function balPath(batch){return /databases/$(database)/documents/cropBalances/$(batch);}
  function movePair(id,v,oldCount){
    let path=balPath(v.batch);
    let prior=get(path).data;
    let after=getAfter(path).data;
    return v.stockTracked==true && v.count is int && v.count>=0 && after.last==id
      && after.remaining==prior.remaining+oldCount-v.count && after.remaining>=0;
  }
  function cropCreate(id,d){return d.type!='xplant' || (d.sec=='t' && d.v.count>0 && movePair(id,d.v,0));}
  function cropUpdate(id,d,old){
    return old.type==d.type && (old.type!='xplant' || (d.sec==old.sec && d.v.get('batch','')==old.v.get('batch','') && d.v.get('stockTracked',false)==old.v.get('stockTracked',false)
      && (d.v.count==old.v.count || (old.v.get('stockTracked',false) && movePair(id,d.v,old.v.count)))));
  }
  function balanceMove(batch){
    let a=request.resource.data;
    let p=/databases/$(database)/documents/entries/$(a.last);
    let e=getAfter(p).data;
    let prior=exists(p)?get(p).data.v.count:0;
    return okId(a.last) && a.diff(resource.data).affectedKeys().hasOnly(['remaining','last'])
      && e.type=='xplant' && e.v.stockTracked==true && e.v.batch==batch && e.v.count is int && e.v.count!=prior
      && a.remaining is int && a.remaining>=0 && a.remaining==resource.data.remaining+prior-e.v.count;
  }
  match /cropBalances/{batch}{
    allow read: if isMember();
    allow create: if isSup() && getAfter(/databases/$(database)/documents/entries/$(batch)).data.type=='sow'
      && request.resource.data.keys().hasOnly(['opening','remaining','by','opened','last'])
      && request.resource.data.by==request.auth.uid && request.resource.data.opened==request.time
      && request.resource.data.last=='' && request.resource.data.opening is int && request.resource.data.opening>=0 && request.resource.data.remaining==request.resource.data.opening;
    allow update: if isMember() && balanceMove(batch);
  }
  match /config/owner {
   allow read: if true;
   allow create: if signedIn() && request.resource.data.uid==request.auth.uid;
  }
  match /config/settings {allow read: if isMember(); allow write: if isSup();}
  match /users/{uid} {
   allow read: if isMember() || (signedIn() && request.auth.uid==uid);
   allow create,update: if isOwner();
  }
  match /entries/{id}{
   allow read: if isMember();
   allow create: if isMember() && okId(id) && cropCreate(id,request.resource.data) && okEntry(request.resource.data) && (isSup() || ordinaryEntry(request.resource.data)) && request.resource.data.by==request.auth.uid && !('review' in request.resource.data) && (isSup() || workerDay(request.resource.data.date));
   allow update: if isSup() && cropUpdate(id,request.resource.data,resource.data) && validWater(request.resource.data) && (!('thumb' in request.resource.data)||okImg(request.resource.data.thumb,200000));
   allow update: if isWorker() && resource.data.type=='selftest' && resource.data.by==request.auth.uid && !('review' in resource.data) && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['v']) && request.resource.data.v is map;
   allow update: if isWorker() && resource.data.type=='note' && resource.data.by==request.auth.uid && !('review' in resource.data) && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['open']) && request.resource.data.open is bool;
   allow update: if isWorker() && resource.data.type=='batt' && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['v']) && request.resource.data.v.diff(resource.data.v).affectedKeys().hasOnly(['end','endBy']) && resource.data.v.get('end',null)==null && request.resource.data.v.end is number && request.resource.data.v.endBy==request.auth.uid;
   allow delete: if resource.data.type!='xplant' && (resource.data.type!='sow' || !exists(balPath(id))) && (isSup() || (isWorker() && ordinaryEntry(resource.data) && resource.data.by==request.auth.uid && !('review' in resource.data)));
  }
  match /photos/{id}{
   allow read: if isMember();
   allow create: if isMember() && okId(id) && request.resource.data.by==request.auth.uid && request.resource.data.keys().hasOnly(['data','by','ts','sec']) && request.resource.data.data is string && request.resource.data.data.size()<=1000000;
   allow delete: if isSup();
  }
  match /recipes/{id}{allow read: if isMember(); allow write: if isSup();}
  match /signoffs/{day}{allow read: if isMember(); allow write: if isSup();}
// GREEN SIDE 2.11.1 — add inside match /databases/{database}/documents, MAIN project only.
function gs11Owner(){return request.auth != null && get(/databases/$(database)/documents/config/owner).data.uid == request.auth.uid;}
function gs11Member(){return request.auth != null && (gs11Owner() || get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role in ['sup','worker']);}
function gs11Supervisor(){return gs11Owner() || (request.auth != null && get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'sup');}
function gs11New(){return gs11Member() && request.resource.data.by == request.auth.uid && request.resource.data.created == request.time;}
function gs11Day(d){return d is string && d.matches('[0-9]{4}-[0-9]{2}-[0-9]{2}');}
match /farmWater/{id} {
 allow read: if gs11Member();
 allow create: if gs11New() && request.resource.data.keys().hasOnly(['by','date','invoice','supplier','tank','tons','time','occurred','created']) && gs11Day(request.resource.data.date) && request.resource.data.tons is number && request.resource.data.tons>0 && request.resource.data.tons<=18 && request.resource.data.tank in ['الخزان الرئيسي لمياه الخلايا','الخزان الرئيسي لمياه الري'];
}
match /farmService/{id} {
 allow read: if gs11Member();
 allow create: if gs11New() && request.resource.data.keys().hasOnly(['by','date','kind','result','memo','created']) && gs11Day(request.resource.data.date) && request.resource.data.kind in ['فحص تسريبات خطوط الري','تنظيف الفلتر الشبكي','تنظيف الفلتر القرصي','تنظيف فلتر السلة'] && (request.resource.data.result!='يوجد تسريب' || (request.resource.data.memo.size()>0 && getAfter(/databases/$(database)/documents/farmJobs/$(id)).data.by==request.auth.uid));
}
match /farmJobs/{id} {
 allow read: if gs11Member();
 allow create: if gs11New() && request.resource.data.keys().hasOnly(['title','by','assignee','due','status','note','created']) && gs11Day(request.resource.data.due) && request.resource.data.status=='معلقة' && request.resource.data.title.size()>0 && (gs11Supervisor() || (request.resource.data.assignee==request.auth.uid && getAfter(/databases/$(database)/documents/farmService/$(id)).data.result=='يوجد تسريب'));
 allow update: if gs11Member() && (gs11Supervisor() || resource.data.assignee==request.auth.uid) && resource.data.status!='مكتملة' && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['note','status','due','changedAt','changedBy','history']) && request.resource.data.status in ['مكتملة','مؤجلة'] && gs11Day(request.resource.data.due) && request.resource.data.changedBy==request.auth.uid && request.resource.data.changedAt==request.time;
}
match /farmMessages/{id} {
 allow read: if gs11Member() && (resource.data.audience=='team' || resource.data.by==request.auth.uid || resource.data.audience==request.auth.uid);
 allow create: if gs11New() && request.resource.data.keys().hasOnly(['by','audience','task','body','created']) && request.resource.data.body is string && request.resource.data.body.size()>0 && request.resource.data.body.size()<=2000 && (request.resource.data.audience=='team' || exists(/databases/$(database)/documents/users/$(request.resource.data.audience)));
}
match /farmLedger/{id} {
 allow read: if gs11Owner();
 allow create,update: if gs11Owner() && request.resource.data.amount is number && request.resource.data.amount>=0 && request.resource.data.by==request.auth.uid && gs11Day(request.resource.data.date) && request.resource.data.allocation is list;
}
function gs11Entry(d){
 return d.keys().hasOnly(['type','sec','date','time','ts','by','v','grp','photo','thumb','open','review']) && d.sec in ['n','t','g'] && gs11Day(d.date) && d.time is string && d.time.matches('[0-2][0-9]:[0-5][0-9]') && d.v is map && d.type in ['sow','xplant','harvest','refill','waterOnly','mix','light','note','temp','ecph','photo','spray','pump','irr','batt','cal'];
}
function gs11AuditPair(id,prior){
 let a=getAfter(/databases/$(database)/documents/farmChanges/$(request.resource.data.v.auditId)).data;
 return a.created==request.time && a.by==request.auth.uid && a.entry==id && a.date==request.resource.data.date && a.type==request.resource.data.type && a.before==prior && a.after==request.resource.data.v && !a.requested;
}
match /entries/{id} {
 allow create: if gs11Member() && okId(id) && cropCreate(id,request.resource.data) && okEntry(request.resource.data) && (isSup() || ordinaryEntry(request.resource.data)) && dayOf(request.resource.data.date)<=farmDay() && gs11Entry(request.resource.data) && request.resource.data.by==request.auth.uid && !('review' in request.resource.data) && gs11AuditPair(id,null);
 allow update: if gs11Member() && cropUpdate(id,request.resource.data,resource.data) && (isSup() || ordinaryEntry(resource.data)) && resource.data.by==request.auth.uid && !('review' in resource.data) && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['v','time','open','photo','thumb']) && okEntry(request.resource.data) && (isSup() || ordinaryEntry(request.resource.data)) && gs11Entry(request.resource.data) && gs11AuditPair(id,resource.data.v);
}
match /farmChanges/{id} {
 allow read: if gs11Member() && (gs11Supervisor() || resource.data.by==request.auth.uid);
 allow create: if gs11New() && request.resource.data.keys().hasOnly(['entry','by','date','type','sec','before','after','requested','reason','created']) && request.resource.data.reason is string && request.resource.data.reason.size()>0 && request.resource.data.reason.size()<=300 && request.resource.data.after.auditId==id && gs11ChangeTarget(id);
 allow update: if gs11Supervisor() && resource.data.requested && !('resolution' in resource.data) && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['resolution','reviewedBy','reviewedAt','resolutionReason']) && request.resource.data.reviewedBy==request.auth.uid && request.resource.data.reviewedAt==request.time && request.resource.data.resolution in ['معتمد','مرفوض'] && (!('resolutionReason' in request.resource.data) || (request.resource.data.resolutionReason is string && request.resource.data.resolutionReason.size()<=300));
}
function gs11ChangeTarget(id){
 let d=request.resource.data;
 let path=/databases/$(database)/documents/entries/$(d.entry);
 let target=getAfter(path).data;
 return (gs11Supervisor() || (ordinaryEntry(target) && (d.type!='cal' || !('careKind' in d.after)))) && target.by==request.auth.uid && target.date==d.date && target.sec==d.sec && target.type==d.type && (d.requested==true ? ('review' in target && target.v==d.before) : (target.v==d.after && (exists(path)?get(path).data.v==d.before:d.before==null)));
}

match /farmLevels/{id}{
 allow read: if gs11Member();
 allow create: if gs11Supervisor() && gs11New() && request.resource.data.keys().hasOnly(['by','date','time','observed','tons','memo','created']) && gs11Day(request.resource.data.date) && request.resource.data.observed is int && request.resource.data.tons is number && request.resource.data.tons>=0 && request.resource.data.tons<=18;
}

 match /{document=**}{allow read,write: if false;}
 }
}
